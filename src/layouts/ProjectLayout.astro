---
import '../styles/layouts/blog-post.css';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/paths';
import { serializeScriptJson } from '../utils/serialize-script-json';

type Props = CollectionEntry<'projects'>['data'] & {
  relatedPosts?: CollectionEntry<'blog'>[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  stack = [],
  status,
  demoUrl,
  repoUrl,
  relatedPosts = [],
} = Astro.props;

const projectsBase = withBase('/projects');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pubDateISO = pubDate.toISOString();
const updatedDateISO = updatedDate?.toISOString();
const statusLabel = status.replace('-', ' ');

const jsonLd = serializeScriptJson({
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  datePublished: pubDateISO,
  ...(updatedDateISO && { dateModified: updatedDateISO }),
  url: canonicalURL.href,
  ...(heroImage && { image: new URL(heroImage.src, Astro.site).href }),
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  pubDate={pubDateISO}
  updatedDate={updatedDateISO}
  bodyClass="post-page"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <main id="main-content" class="post-main project-main">
    <article data-pagefind-body>
      <a href={projectsBase} class="back-link">← All Projects</a>

      <header class="post-header">
        <div class="post-accent"></div>
        <div class="post-meta">
          <FormattedDate class="meta-date" date={pubDate} />
          <span class="dot">·</span>
          <span class="project-status">{statusLabel}</span>
          {
            updatedDate && (
              <>
                <span class="dot">·</span>
                <span class="meta-updated">
                  Updated <FormattedDate date={updatedDate} />
                </span>
              </>
            )
          }
        </div>
        <h1 class="post-title" data-pagefind-meta="title">{title}</h1>
        {description && <p class="post-description">{description}</p>}
        {
          (stack.length > 0 || demoUrl || repoUrl) && (
            <div class="project-summary" data-pagefind-ignore="all">
              {stack.length > 0 && (
                <ul class="project-stack" aria-label="Project stack">
                  {stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              <div class="project-links">
                {demoUrl && (
                  <a href={demoUrl} target="_blank" rel="noopener">
                    Demo ↗
                  </a>
                )}
                {repoUrl && (
                  <a href={repoUrl} target="_blank" rel="noopener">
                    Source ↗
                  </a>
                )}
              </div>
            </div>
          )
        }
      </header>

      <div class="post-divider"></div>

      <div class="prose" id="prose-content">
        <slot />
      </div>

      {
        relatedPosts.length > 0 && (
          <section class="related-section" data-pagefind-ignore="all">
            <div class="related-header">
              <p class="related-label">Related posts</p>
              <a href={withBase('/blog')} class="related-view-all">
                All Posts →
              </a>
            </div>
            <ol class="related-post-list">
              {relatedPosts.map((post) => (
                <li>
                  <a href={withBase(`/blog/${post.id}/`)}>
                    <span>{post.data.title}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                  <p>{post.data.description}</p>
                </li>
              ))}
            </ol>
          </section>
        )
      }
    </article>
  </main>
  <ImageLightbox />
</BaseLayout>

<style>
  .project-status {
    text-transform: capitalize;
  }

  .project-summary {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .project-stack,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-stack li {
    font-family: var(--font-mono);
    font-size: var(--text-caption-1);
    color: var(--label-tertiary);
  }

  .project-links a {
    font-family: var(--font-mono);
    font-size: var(--text-footnote);
    font-weight: var(--weight-medium);
    color: var(--label-secondary);
    text-decoration: none;
  }

  .project-links a:hover {
    color: var(--color-blue);
    opacity: 1;
  }

  .related-post-list {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-post-list a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: baseline;
    color: var(--label-primary);
    font-size: var(--text-headline);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .related-post-list a:hover {
    color: var(--color-blue);
    opacity: 1;
  }

  .related-post-list p {
    max-width: 56ch;
    margin: var(--space-2) 0 0;
    color: var(--label-secondary);
    font-size: var(--text-callout);
    line-height: var(--leading-relaxed);
  }
</style>
