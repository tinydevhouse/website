<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Switch theme"
  title="Switch theme"
>
  <svg
    class="theme-icon theme-icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
    <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008"></path>
  </svg>
  <svg
    class="theme-icon theme-icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
    <path d="M14.828 14.828a4 4 0 1 0 -5.656 -5.656a4 4 0 0 0 5.656 5.656"></path>
    <path d="M6.343 17.657l-1.414 1.414"></path>
    <path d="M6.343 6.343l-1.414 -1.414"></path>
    <path d="M17.657 6.343l1.414 -1.414"></path>
    <path d="M17.657 17.657l1.414 1.414"></path>
    <path d="M4 12h-2"></path>
    <path d="M12 4v-2"></path>
    <path d="M20 12h2"></path>
    <path d="M12 20v2"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    function mountThemeToggle() {
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      if (!(toggle instanceof HTMLButtonElement) || toggle.dataset.ready === 'true') return;
      toggle.dataset.ready = 'true';

      function normalize(theme) {
        return theme === 'dark' || theme === 'mocha' || theme === 'macchiato' || theme === 'frappe'
          ? 'mocha'
          : 'latte';
      }

      function sync() {
        const current = root.getAttribute('data-theme') || 'latte';
        const active = normalize(current);
        if (current !== active) {
          root.setAttribute('data-theme', active);
          return;
        }
        const isDark = active === 'mocha';
        toggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        toggle.setAttribute('title', isDark ? 'Switch to light theme' : 'Switch to dark theme');
      }

      toggle.addEventListener('click', () => {
        const next = normalize(root.getAttribute('data-theme') || 'latte') === 'mocha' ? 'latte' : 'mocha';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          // The visible control still works when storage is unavailable.
        }
        sync();
      });

      new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      sync();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountThemeToggle, { once: true });
    } else {
      mountThemeToggle();
    }
  })();
</script>

<style>
.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.9rem;
  height: 1.9rem;
  padding: 0;
  appearance: none;
  border: 1px solid var(--separator);
  border-radius: var(--radius-xs);
  background: transparent;
  color: var(--label-secondary);
  font: inherit;
  line-height: 1;
  cursor: pointer;
  transition:
    border-color var(--duration-fast) var(--ease-out),
    color var(--duration-fast) var(--ease-out),
    background-color var(--duration-fast) var(--ease-out);
}

.theme-toggle:hover {
  border-color: var(--label-tertiary);
  background: var(--bg-secondary);
  color: var(--label-primary);
}

.theme-toggle:focus-visible {
  outline: 1px solid currentColor;
  outline-offset: 0.18rem;
}

.theme-icon {
  width: 1rem;
  height: 1rem;
}

.theme-icon-sun {
  display: none;
}

:global([data-theme='mocha']) .theme-icon-moon,
:global([data-theme='dark']) .theme-icon-moon,
:global([data-theme='macchiato']) .theme-icon-moon,
:global([data-theme='frappe']) .theme-icon-moon {
  display: none;
}

:global([data-theme='mocha']) .theme-icon-sun,
:global([data-theme='dark']) .theme-icon-sun,
:global([data-theme='macchiato']) .theme-icon-sun,
:global([data-theme='frappe']) .theme-icon-sun {
  display: block;
}
</style>
