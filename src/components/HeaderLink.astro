---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/paths';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizedHref = typeof href === 'string' ? href : '/';
const pathname = withoutBase(Astro.url.pathname);
const isActive =
  pathname === normalizedHref ||
  pathname.startsWith(normalizedHref === '/' ? '/#' : normalizedHref + '/');
---

<a
  href={withBase(normalizedHref)}
  aria-current={isActive ? 'page' : undefined}
  class:list={['nav-link', className, { active: isActive }]}
  {...props}
>
  <slot />
</a>

<style>
.nav-link {
  display: inline-flex;
  align-items: center;
  padding: 0;
  font-size: var(--text-caption-1);
  font-weight: var(--weight-regular);
  color: var(--label-secondary);
  white-space: nowrap;
  text-decoration-line: underline;
  text-decoration-color: transparent;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.25em;
  transition:
    color var(--duration-fast) var(--ease-out),
    text-decoration-color var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}

.nav-link:hover {
  color: var(--color-link);
  text-decoration-color: currentColor;
  opacity: 1;
}

.nav-link.active {
  color: var(--color-link);
  text-decoration-color: currentColor;
}
</style>
