---
import '../styles/pages/home.css';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import HomeMicroGrid from '../components/HomeMicroGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getUiText } from '../ui';
import { withBase } from '../utils/paths';
import { getNumberedProjects } from '../utils/projects';
const tr = getUiText();

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = posts.slice(0, 5);
const recentMicros = (await getCollection('micros'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
const projects = getNumberedProjects(await getCollection('projects'))
  .filter(({ project }) => project.data.featured)
  .slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main id="main-content" class="home-main page-shell">
    <section class="home-hero">
      <h1 class="home-hero-title">
        <span>Tiny</span>
        <span>Dev</span>
        <span>House</span>
      </h1>
      <p class="home-hero-desc">{SITE_DESCRIPTION}</p>
    </section>

    {
      projects.length > 0 && (
        <section class="home-section">
          <div class="home-section-header">
            <h2 class="home-section-label">Projects</h2>
            <a href={withBase('/projects')} class="home-view-all">
              All projects ↗
            </a>
          </div>
          <ol class="home-project-list index-list">
            {projects.map(({ project, num }) => (
              <li class="home-project-item">
                <a
                  href={withBase(`/projects/${project.id}/`)}
                  class:list={[
                    'home-project-link',
                    'index-link',
                    project.data.heroImage && 'home-project-link--media',
                  ]}
                >
                  <span class="home-project-num index-num" aria-hidden="true">
                    {num}
                  </span>
                  {project.data.heroImage && (
                    <span class="home-project-media">
                      <span class="home-project-window-bar" aria-hidden="true">
                        <span />
                        <span />
                        <span />
                      </span>
                      <Image
                        src={project.data.heroImage}
                        alt=""
                        class="home-project-img"
                        widths={[320, 480, 700, 960, 1280]}
                        sizes="(max-width: 680px) calc(100vw - 3rem), 14rem"
                        quality={88}
                      />
                    </span>
                  )}
                  <span class="home-project-content">
                    <span class="home-project-top">
                      <span class="home-project-name">
                        {project.data.title}
                        <span class="home-project-ext-arrow" aria-hidden="true">
                          ↗
                        </span>
                      </span>
                      <span class="home-project-status">
                        {project.data.status.replace('-', ' ')}
                      </span>
                    </span>
                    <span class="home-project-desc">{project.data.description}</span>
                    {project.data.stack.length > 0 && (
                      <span class="home-project-tags index-tags" aria-label="Tags">
                        {project.data.stack.map((tag) => (
                          <span class="home-project-tag index-tag">{tag}</span>
                        ))}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="home-section">
          <div class="home-section-header">
            <h2 class="home-section-label">{tr.blogEyebrow}</h2>
            <a href={withBase('/blog')} class="home-view-all">
              All articles ↗
            </a>
          </div>
          <ol class="home-post-list index-list">
            {recentPosts.map((post, i) => (
              <li class="home-post-item">
                <a href={withBase(`/blog/${post.id}/`)} class="home-post-link index-link">
                  <span class="home-post-num index-num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="home-post-title index-title">{post.data.title}</span>
                  <span class="home-post-date index-date">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  <span class="home-post-arrow index-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      recentMicros.length > 0 && (
        <section class="home-section">
          <div class="home-section-header">
            <h2 class="home-section-label">Little thoughts</h2>
            <a href={withBase('/blog')} class="home-view-all">
              All micros ↗
            </a>
          </div>
          <HomeMicroGrid micros={recentMicros} />
        </section>
      )
    }
  </main>
</BaseLayout>
