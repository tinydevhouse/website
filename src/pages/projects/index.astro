---
import '../../styles/pages/blog-index.css';
import '../../styles/pages/projects.css';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { withBase } from '../../utils/paths';
import { getNumberedProjects } from '../../utils/projects';

const projects = getNumberedProjects(await getCollection('projects'));
---

<BaseLayout title="Projects" description={SITE_DESCRIPTION}>
  <main id="main-content" class="blog-main projects-main page-shell">
    <div class="blog-header">
      <div>
        <p class="blog-label eyebrow-accent">Work</p>
        <h1 class="blog-title">Projects</h1>
      </div>
    </div>

    <ol class="projects-list index-list">
      {
        projects.map(({ project, num }) => (
          <li class="projects-item">
            <a href={withBase(`/projects/${project.id}/`)} class="projects-link index-link">
              <span class="projects-num index-num" aria-hidden="true">
                {num}
              </span>
              <div class="projects-body">
                <div class="projects-top">
                  <h2 class="projects-title">{project.data.title}</h2>
                  <span class="projects-status">{project.data.status.replace('-', ' ')}</span>
                </div>
                <p class="projects-desc">{project.data.description}</p>
                {project.data.stack.length > 0 && (
                  <ul class="projects-stack index-tags" aria-label={`${project.data.title} stack`}>
                    {project.data.stack.map((item) => (
                      <li class="index-tag">{item}</li>
                    ))}
                  </ul>
                )}
              </div>
              <span class="projects-arrow index-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
