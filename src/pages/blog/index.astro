---
import '../../styles/pages/blog-index.css';
import PostFeed from '../../components/PostFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getUiText } from '../../ui';

const tr = getUiText();
---

<BaseLayout title={tr.blogTitle} description={SITE_DESCRIPTION}>
  <main id="main-content" class="blog-main page-shell">
    <div class="blog-header">
      <div>
        <p class="blog-label eyebrow-accent">{tr.blogEyebrow}</p>
        <h1 class="blog-title">{tr.blogTitle}</h1>
      </div>
    </div>

    <PostFeed basePath="/blog" initialVisible={8} />
  </main>
</BaseLayout>
